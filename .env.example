# Azure PostgreSQL Configuration
PGHOST=your-postgres-host
PGUSER=your-postgres-user
PGPORT=your-postgres-port
PGPASSWORD=your-postgres-password
PGDATABASE=your-postgres-database

# Derived for SQLAlchemy (Async)
DATABASE_URL=postgresql+asyncpg://your-postgres-user:your-postgres-password@your-postgres-host:your-postgres-port/your-postgres-database

# GitLab
GITLAB_URL=https://gitlab.com/api/v4
GITLAB_TOKEN=your-token

# Jira
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=your_jira_api_token
